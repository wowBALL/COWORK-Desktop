REDMINE_URL=https://proj.example.com
REDMINE_API_KEY=replace-with-your-redmine-api-key
# Path to the A_Workspace markdown vault (used by the Workspace tab).
# Defaults to ../A_Workspace when unset. Set an absolute path for installed builds.
WORKSPACE_DIR=D:\COWORK\A_Workspace
# GitHub token so installed builds can check/download releases from the private
# wowBALL/myjobs repo for auto-update. Fine-grained PAT, read-only, scoped to
# this repo's "Contents" permission is enough.
GH_TOKEN=replace-with-a-repo-scoped-github-token
