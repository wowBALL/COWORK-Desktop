{
  "name": "cowork-desktop",
  "version": "1.9.17",
  "description": "COWORK Command Center — desktop widget & screensaver",
  "main": "main.js",
  "scripts": {
    "widget": "electron . --widget",
    "screensaver": "electron . --screensaver",
    "start": "electron . --widget",
    "test": "node --test \"tests/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "author": "Ball",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wowBALL/COWORK-Desktop.git"
  },
  "homepage": "https://github.com/wowBALL/COWORK-Desktop#readme",
  "bugs": {
    "url": "https://github.com/wowBALL/COWORK-Desktop/issues"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cowork.desktop",
    "productName": "COWORK Desktop",
    "files": [
      "main.js",
      "preload.js",
      "util.js",
      "datefilter.js",
      "tab-redmine.js",
      "tab-redmine.css",
      "tab-workspace.js",
      "tab-workspace.css",
      "tab-qatest.js",
      "tab-qatest.css",
      "tab-meeting.js",
      "tab-meeting.css",
      "tab-grafana.js",
      "tab-grafana.css",
      "workspace.js",
      "meetings.js",
      "glossary.js",
      "llm.js",
      "redmine-issue-form.js",
      "qatest.js",
      "grafana.js",
      "uidump.js",
      "meetingrun.js",
      "meetingrun.css",
      "widget.html",
      "screensaver.html",
      "icons/**/*",
      "LICENSE"
    ],
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COWORK Desktop"
    }
  }
}
