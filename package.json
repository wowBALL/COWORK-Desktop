{
  "name": "cowork-desktop",
  "version": "1.1.0",
  "description": "COWORK Command Center — desktop widget & screensaver",
  "main": "main.js",
  "scripts": {
    "widget": "electron . --widget",
    "screensaver": "electron . --screensaver",
    "start": "electron . --widget",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "author": "Ball",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cowork.desktop",
    "productName": "COWORK Desktop",
    "files": [
      "main.js",
      "preload.js",
      "workspace.js",
      "widget.html",
      "screensaver.html",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "wowBALL",
        "repo": "myjobs",
        "private": true
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COWORK Desktop"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
