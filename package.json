{
  "name": "cowork-desktop",
  "version": "1.3.8",
  "description": "COWORK Command Center — desktop widget & screensaver",
  "main": "main.js",
  "scripts": {
    "widget": "electron . --widget",
    "screensaver": "electron . --screensaver",
    "start": "electron . --widget",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "author": "Ball",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cowork.desktop",
    "productName": "COWORK Desktop",
    "files": [
      "main.js",
      "preload.js",
      "workspace.js",
      "widget.html",
      "screensaver.html",
      "icons/**/*"
    ],
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COWORK Desktop"
    }
  }
}
